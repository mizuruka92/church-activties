# Copy this file to secrets.toml (same folder) ONLY to run the dashboard on your own computer.
# secrets.toml is ignored by Git. Never commit it, never paste it into a chat or an issue.
# Not needed when the app runs inside Snowflake (Streamlit in Snowflake).
#
# Replace every <placeholder>. Find your account identifier in Snowsight:
# click your name (bottom left) > Account > View account details.

[connections.snowflake]
account = "<organisation_name>-<account_name>"
user = "<your_snowflake_user_name>"
role = "<role, for example SYSADMIN>"
warehouse = "<warehouse, for example COMPUTE_WH>"
database = "PUSAT_INFORMASI_PAROKI"
schema = "ANALISIS"

# Pick ONE way to sign in (see docs/STARTER_GUIDE.md, part 10). Key-pair sign-in works without a browser:
authenticator = "SNOWFLAKE_JWT"
private_key_file = "<full path to your private key file, kept outside this repository>"
# private_key_file_pwd = "<only if the key file is protected by a passphrase>"
